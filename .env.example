# Copy to .env, replace the placeholders, then run: source .env

# FalkorDB Cloud (Free tier uses SSL=false)
export FALKORDB_HOST='your-instance-host'
export FALKORDB_PORT='your-instance-port'
export FALKORDB_USERNAME='your-instance-username'
export FALKORDB_PASSWORD='your-instance-password'
export FALKORDB_SSL='false'
export FALKORDB_GRAPH='pr_impact'

# Optional: only needed for `review --llm` or `pr --llm`
export OPENROUTER_API_KEY=''
export OPENROUTER_MODEL='openai/gpt-5.6-luna' # paid; use openrouter/free for the free route
